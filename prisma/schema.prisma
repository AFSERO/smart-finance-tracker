// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  currency      String    @default("USD")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  transactions  Transaction[]
  assets        Asset[]
  categories    Category[]
  goals         Goal[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Transaction {
  id          String    @id @default(cuid())
  userId      String
  amount      Float
  description String
  date        DateTime
  type        TransactionType
  categoryId  String?
  subcategory String?
  merchant    String?
  source      TransactionSource @default(MANUAL)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([userId, date])
  @@index([userId, type])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      CategoryType
  icon      String?
  color     String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]

  @@index([userId, type])
}

model Asset {
  id            String    @id @default(cuid())
  userId        String
  name          String
  type          AssetType
  quantity      Float
  currentValue  Float
  purchasePrice Float?
  purchaseDate  DateTime?
  assetData     Json?     // Flexible storage for asset-specific data
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Goal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  type          GoalType
  targetAmount  Float
  currentAmount Float @default(0)
  deadline      DateTime?
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Rate {
  id         String   @id @default(cuid())
  kind       RateKind
  code       String   // e.g., USD, EUR, GOLD_GRAM, GOLD_OUNCE
  unitPrice  Float
  fetchedAt  DateTime @default(now())

  @@unique([kind, code], name: "kind_code")
  @@index([kind, code])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  PDF_UPLOAD
  API_IMPORT
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum AssetType {
  GOLD
  CURRENCY
  STOCK
  CRYPTO
  REAL_ESTATE
  CUSTOM
}

enum RateKind {
  CURRENCY
  GOLD
}

enum GoalType {
  MONTHLY_INCOME
  SAVINGS
  INVESTMENT
  DEBT_PAYOFF
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}